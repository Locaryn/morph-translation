{
  "$schema": "https://locaryn.dev/schema/plugin.json/v0.1",
  "apiVersion": "0.1",
  "name": "extension-translation",
  "version": "1.1.0",
  "description": "Traduction automatique multilingue (NLLB-200, Opus-MT) de code, documentation et messages.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/extension-translation",
  "repository": "https://github.com/Locaryn/extension-translation",
  "keywords": [
    "translation",
    "multilingual",
    "nllb",
    "opus-mt",
    "i18n"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de traduction multilingue local."
    },
    "files.read": {
      "reason": "Lire les modèles de traduction et dictionnaires."
    },
    "files.write": {
      "reason": "Sauvegarder les traductions et fichiers exportés."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "translation"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "translation-catalog",
        "slot": "marketplace.catalogs",
        "order": 11,
        "type": "data",
        "label": "Modèles de traduction automatique",
        "icon": "translate",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles NLLB-200 et Opus-MT au catalogue"
      },
      {
        "id": "translation-studio",
        "slot": "studio.tabs",
        "order": 11,
        "label": "Traduction",
        "icon": "translate",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-translation-panel",
        "hint": "Traduction instantanée multilingue"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  }
}
