{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-translation",
  "version": "2.1.0",
  "description": "Traduire par le moteur d'inference local : le texte ne quitte pas la machine. Rend la traduction seule, sans preambule ni note du traducteur.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-translation",
  "repository": "https://github.com/Locaryn/morph-translation",
  "keywords": [
    "translation",
    "multilingual",
    "nllb",
    "opus-mt",
    "i18n"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de traduction multilingue local."
    },
    "files.read": {
      "reason": "Lire les modèles de traduction et dictionnaires."
    },
    "files.write": {
      "reason": "Sauvegarder les traductions et fichiers exportés."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "translation"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "translation-catalog",
        "slot": "marketplace.catalogs",
        "order": 11,
        "type": "data",
        "label": "Modèles de traduction automatique",
        "icon": "translate",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles NLLB-200 et Opus-MT au catalogue"
      },
      {
        "id": "translation-studio",
        "slot": "studio.tabs",
        "order": 11,
        "label": "Traduction",
        "icon": "translate",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-translation-panel",
        "hint": "Traduction instantanée multilingue"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-translation#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-translation#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-translation#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-translation#v1.0.0"
    }
  ]
}
