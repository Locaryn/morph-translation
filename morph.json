{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-translation",
  "version": "1.0.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Traduction automatique multilingue (NLLB-200, Opus-MT) de code, documentation et messages. Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-translation",
  "repository": "https://github.com/Locaryn/morph-translation",
  "keywords": [
    "translation",
    "multilingual",
    "nllb",
    "opus-mt",
    "i18n"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de traduction multilingue local."
    },
    "files.read": {
      "reason": "Lire les modèles de traduction et dictionnaires."
    },
    "files.write": {
      "reason": "Sauvegarder les traductions et fichiers exportés."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "translation"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "translation-catalog",
        "slot": "marketplace.catalogs",
        "order": 11,
        "type": "data",
        "label": "Modèles de traduction automatique",
        "icon": "translate",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles NLLB-200 et Opus-MT au catalogue"
      },
      {
        "id": "translation-studio",
        "slot": "studio.tabs",
        "order": 11,
        "label": "Traduction",
        "icon": "translate",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-translation-panel",
        "hint": "Traduction instantanée multilingue"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
